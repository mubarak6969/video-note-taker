# Copy this file to `.env` and fill in your own values. `.env` is
# git-ignored and should never be committed.

# Required: get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional overrides (defaults shown) -----------------------------------
# GROQ_MODEL=openai/gpt-oss-120b
# WHISPER_MODEL_SIZE=base
# CHUNK_DURATION_SECONDS=30      # YouTube / audio-video uploads
# CHUNK_OVERLAP_SECONDS=5
# CHUNK_MAX_CHARS=1200           # PDF / text uploads
# CHUNK_OVERLAP_CHARS=150
# DOWNLOADS_DIR=downloads
# DATA_DIR=data

# --- Uploads ------------------------------------------------------------
# UPLOAD_MAX_PDF_MB=25
# UPLOAD_MAX_TEXT_MB=5
# UPLOAD_MAX_AUDIO_MB=200

# --- Retrieval (hybrid search + reranking) ----------------------------------
# RAG_TOP_K=3                  # chunks finally sent to the LLM
# RAG_CANDIDATE_COUNT=15       # candidates considered before reranking
# RETRIEVAL_MODE=hybrid        # hybrid | vector | keyword
# RERANK_METHOD=heuristic      # heuristic | cross_encoder | none
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_WEIGHT_VECTOR=0.45
# RERANK_WEIGHT_KEYWORD=0.35
# RERANK_WEIGHT_EXACT=0.20
# HYBRID_RRF_K=60
